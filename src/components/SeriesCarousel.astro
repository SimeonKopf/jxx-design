---
export interface Props {
  series: {
    id: string;
    title: string;
    description: string;
    artworks: Array<{
      id: string;
      title: string;
      price: string;
      sold: boolean;
      image: string;
    }>;
  };
  imageLeft?: boolean;
}

const { series, imageLeft = false } = Astro.props;
---

<div class={`series-container ${imageLeft ? 'image-left' : 'image-right'} w-full max-w-6xl mx-auto`}>
  <!-- Desktop Layout -->
  <div class="hidden md:grid md:grid-cols-2 gap-16 items-center px-4">
    <div class={`carousel-container ${imageLeft ? '' : 'md:order-2'}`}>
      <div class="relative bg-white rounded-xl shadow-sm overflow-hidden mx-auto max-w-md">
        <div class="desktop-carousel relative" data-series={series.id}>
          <div class="desktop-track flex transition-transform duration-500 ease-in-out">
            {series.artworks.map((artwork, index) => (
              <div class="desktop-slide flex-shrink-0 w-full relative group cursor-pointer" data-artwork-id={artwork.id}>
                <a href={`/artwork/${artwork.id}`} class="block w-full h-full">
                  <img 
                    src={artwork.image} 
                    alt={artwork.title}
                    class="w-full h-80 object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/5 to-transparent group-hover:from-black/10 transition-all duration-300"></div>
                </a>
                {artwork.sold && (
                  <div class="absolute top-3 right-3 bg-white text-gray-900 px-2 py-1 rounded-md text-xs font-medium shadow-sm">
                    Sold
                  </div>
                )}
              </div>
            ))}
          </div>
          
          {series.artworks.length > 1 && (
            <>
              <button class="desktop-prev absolute left-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-600 rounded-full p-2 shadow-md z-10">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
              </button>
              <button class="desktop-next absolute right-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-600 rounded-full p-2 shadow-md z-10">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </>
          )}
        </div>
        
        {series.artworks.length > 1 && (
          <div class="flex justify-center space-x-1.5 py-3 bg-white">
            {series.artworks.map((_, index) => (
              <button 
                class={`desktop-dot w-1.5 h-1.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-gray-700' : 'bg-gray-300'}`}
                data-index={index}
              ></button>
            ))}
          </div>
        )}
      </div>
    </div>
    
    <div class={`content-container ${imageLeft ? 'md:order-2' : 'md:order-1'} flex flex-col justify-center`}>
      <div class={`space-y-4 ${!imageLeft ? 'text-right' : 'text-left'} max-w-md mx-auto`}>
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 epilogue">{series.title}</h3>
        </div>
        
        <div class="desktop-artwork-info">
          {series.artworks.map((artwork, index) => (
            <div class={`desktop-info ${index === 0 ? 'block' : 'hidden'}`} data-info-index={index}>
              <div class="space-y-1">
                <div class="text-xl font-bold text-gray-900 epilogue">#{artwork.id}</div>
                <div class="text-base font-medium text-gray-700 epilogue">{artwork.title}</div>
                {!artwork.sold && (
                  <div class="text-base font-medium text-gray-900 epilogue">€{artwork.price}</div>
                )}
                {artwork.sold && (
                  <div class="text-base font-medium text-gray-900 epilogue">Sold</div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  
  <!-- Mobile Layout with WORKING SWIPE -->
  <div class="md:hidden px-4">
    <div class="space-y-6 max-w-md mx-auto">
      <div class="text-center">
        <h3 class="text-xl font-bold text-gray-900 mb-4 epilogue">{series.title}</h3>
      </div>
      
      <!-- Mobile Carousel Container -->
      <div class="mobile-swipe-container" data-series={series.id}>
        <div class="relative bg-white rounded-xl shadow-sm overflow-hidden">
          <!-- Swipeable Track -->
          <div class="mobile-swipe-track" data-total={series.artworks.length} data-current="0">
            {series.artworks.map((artwork, index) => (
              <div class="mobile-swipe-slide" data-index={index} data-artwork-id={artwork.id}>
                <img 
                  src={artwork.image} 
                  alt={artwork.title}
                  class="w-full h-72 object-cover"
                  draggable="false"
                />
                {artwork.sold && (
                  <div class="absolute top-3 right-3 bg-white text-gray-900 px-2 py-1 rounded-md text-xs font-medium shadow-sm">
                    Sold
                  </div>
                )}
              </div>
            ))}
          </div>
          
          <!-- Navigation Arrows -->
          {series.artworks.length > 1 && (
            <>
              <button class="mobile-arrow mobile-prev-arrow absolute left-2 top-1/2 -translate-y-1/2 bg-white/90 text-gray-600 rounded-full p-2 shadow-md z-20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
              </button>
              <button class="mobile-arrow mobile-next-arrow absolute right-2 top-1/2 -translate-y-1/2 bg-white/90 text-gray-600 rounded-full p-2 shadow-md z-20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </>
          )}
        </div>
        
        <!-- Progress Dots -->
        {series.artworks.length > 1 && (
          <div class="flex justify-center space-x-1.5 py-3 bg-white rounded-b-xl">
            {series.artworks.map((_, index) => (
              <button 
                class={`mobile-swipe-dot w-1.5 h-1.5 rounded-full transition-colors duration-200 ${index === 0 ? 'bg-gray-700' : 'bg-gray-300'}`}
                data-dot-index={index}
              ></button>
            ))}
          </div>
        )}
      </div>
      
      <!-- Mobile Artwork Info -->
      <div class="text-center">
        <div class="mobile-info-container bg-gray-50 rounded-xl p-4">
          {series.artworks.map((artwork, index) => (
            <div class={`mobile-artwork-info ${index === 0 ? 'block' : 'hidden'}`} data-mobile-info-index={index}>
              <div class="space-y-2">
                <div class="text-lg font-bold text-gray-900">#{artwork.id}</div>
                <div class="text-sm font-medium text-gray-700">{artwork.title}</div>
                {!artwork.sold && (
                  <div class="text-sm font-medium text-gray-900">€{artwork.price}</div>
                )}
                {artwork.sold && (
                  <div class="text-sm font-medium text-gray-900">Sold</div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Global state for mobile carousels
window.mobileCarousels = new Map();

document.addEventListener('DOMContentLoaded', function() {
  // Initialize desktop carousels
  document.querySelectorAll('.desktop-carousel').forEach(initDesktopCarousel);
  
  // Initialize mobile carousels with bulletproof swiping
  document.querySelectorAll('.mobile-swipe-container').forEach(initMobileSwipeCarousel);
});

function initDesktopCarousel(carousel) {
  const track = carousel.querySelector('.desktop-track');
  const slides = carousel.querySelectorAll('.desktop-slide');
  const dots = carousel.parentElement.querySelectorAll('.desktop-dot');
  const prevBtn = carousel.querySelector('.desktop-prev');
  const nextBtn = carousel.querySelector('.desktop-next');
  
  let currentIndex = 0;
  
  function updateDesktop() {
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
    
    dots.forEach((dot, i) => {
      dot.classList.toggle('bg-gray-700', i === currentIndex);
      dot.classList.toggle('bg-gray-300', i !== currentIndex);
    });
    
    const container = carousel.closest('.series-container');
    const infos = container.querySelectorAll('.desktop-info');
    infos.forEach((info, i) => {
      info.classList.toggle('block', i === currentIndex);
      info.classList.toggle('hidden', i !== currentIndex);
    });
  }
  
  function goTo(index) {
    currentIndex = index >= slides.length ? 0 : index < 0 ? slides.length - 1 : index;
    updateDesktop();
  }
  
  prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));
  nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
}

function initMobileSwipeCarousel(container) {
  const seriesId = container.dataset.series;
  const track = container.querySelector('.mobile-swipe-track');
  const slides = container.querySelectorAll('.mobile-swipe-slide');
  const dots = container.querySelectorAll('.mobile-swipe-dot');
  const prevBtn = container.querySelector('.mobile-prev-arrow');
  const nextBtn = container.querySelector('.mobile-next-arrow');
  
  if (slides.length <= 1) return; // Skip if only one slide
  
  // Carousel state
  const state = {
    currentIndex: 0,
    totalSlides: slides.length,
    isAnimating: false,
    touchStart: { x: 0, y: 0, time: 0 },
    touchCurrent: { x: 0, y: 0 },
    isDragging: false,
    threshold: 50,
    velocityThreshold: 0.3
  };
  
  // Store state globally
  window.mobileCarousels.set(seriesId, state);
  
  // Update carousel display
  function updateCarousel(animate = true) {
    if (animate) {
      state.isAnimating = true;
      track.style.transition = 'transform 300ms ease-out';
      track.style.transform = `translateX(-${state.currentIndex * 100}%)`;
      
      setTimeout(() => {
        state.isAnimating = false;
      }, 300);
    } else {
      track.style.transition = 'none';
      track.style.transform = `translateX(-${state.currentIndex * 100}%)`;
    }
    
    // Update dots
    dots.forEach((dot, i) => {
      dot.classList.toggle('bg-gray-700', i === state.currentIndex);
      dot.classList.toggle('bg-gray-300', i !== state.currentIndex);
    });
    
    // Update info
    const mobileSection = container.closest('.md\\:hidden');
    const infos = mobileSection.querySelectorAll('.mobile-artwork-info');
    infos.forEach((info, i) => {
      info.classList.toggle('block', i === state.currentIndex);
      info.classList.toggle('hidden', i !== state.currentIndex);
    });
    
    track.dataset.current = state.currentIndex;
  }
  
  // Navigate to specific slide
  function goToSlide(index, animate = true) {
    if (state.isAnimating) return;
    
    if (index >= state.totalSlides) {
      state.currentIndex = 0;
    } else if (index < 0) {
      state.currentIndex = state.totalSlides - 1;
    } else {
      state.currentIndex = index;
    }
    
    updateCarousel(animate);
  }
  
  // Touch event handlers
  function handleTouchStart(e) {
    if (state.isAnimating) return;
    
    const touch = e.touches[0];
    state.touchStart.x = touch.clientX;
    state.touchStart.y = touch.clientY;
    state.touchStart.time = Date.now();
    state.touchCurrent.x = touch.clientX;
    state.touchCurrent.y = touch.clientY;
    state.isDragging = false;
    
    track.style.transition = 'none';
  }
  
  function handleTouchMove(e) {
    if (state.isAnimating) return;
    
    const touch = e.touches[0];
    state.touchCurrent.x = touch.clientX;
    state.touchCurrent.y = touch.clientY;
    
    const deltaX = state.touchCurrent.x - state.touchStart.x;
    const deltaY = state.touchCurrent.y - state.touchStart.y;
    const absDeltaX = Math.abs(deltaX);
    const absDeltaY = Math.abs(deltaY);
    
    // Determine if this is a horizontal swipe
    if (absDeltaX > 15 && absDeltaX > absDeltaY) {
      if (!state.isDragging) {
        state.isDragging = true;
      }
      
      e.preventDefault(); // Prevent page scroll
      
      // Calculate drag position with resistance at edges
      let dragPercent = (deltaX / track.offsetWidth) * 100;
      let newTranslate = (-state.currentIndex * 100) + dragPercent;
      
      // Add resistance at boundaries
      if (state.currentIndex === 0 && deltaX > 0) {
        dragPercent *= 0.3; // Reduce movement when at first slide swiping right
        newTranslate = dragPercent;
      } else if (state.currentIndex === state.totalSlides - 1 && deltaX < 0) {
        dragPercent *= 0.3; // Reduce movement when at last slide swiping left
        newTranslate = (-state.currentIndex * 100) + dragPercent;
      }
      
      track.style.transform = `translateX(${newTranslate}%)`;
    }
  }
  
  function handleTouchEnd(e) {
    if (state.isAnimating) return;
    
    if (!state.isDragging) {
      // Handle tap to navigate
      const clickedSlide = e.target.closest('.mobile-swipe-slide');
      if (clickedSlide) {
        const artworkId = clickedSlide.dataset.artworkId;
        if (artworkId) {
          window.location.href = `/artwork/${artworkId}`;
        }
      }
      return;
    }
    
    const deltaX = state.touchCurrent.x - state.touchStart.x;
    const deltaTime = Date.now() - state.touchStart.time;
    const velocity = Math.abs(deltaX) / deltaTime;
    const absDeltaX = Math.abs(deltaX);
    
    // Determine if swipe should trigger slide change
    let shouldChange = false;
    let direction = 0;
    
    if (absDeltaX > state.threshold || velocity > state.velocityThreshold) {
      shouldChange = true;
      direction = deltaX > 0 ? -1 : 1; // Right swipe = previous (-1), Left swipe = next (1)
    }
    
    if (shouldChange) {
      goToSlide(state.currentIndex + direction);
    } else {
      // Snap back to current slide
      updateCarousel();
    }
    
    // Reset state
    state.isDragging = false;
  }
  
  // Button event handlers
  function handlePrevClick(e) {
    e.preventDefault();
    e.stopPropagation();
    goToSlide(state.currentIndex - 1);
  }
  
  function handleNextClick(e) {
    e.preventDefault();
    e.stopPropagation();
    goToSlide(state.currentIndex + 1);
  }
  
  function handleDotClick(e) {
    e.preventDefault();
    e.stopPropagation();
    const index = parseInt(e.target.dataset.dotIndex);
    if (!isNaN(index)) {
      goToSlide(index);
    }
  }
  
  // Event listeners
  track.addEventListener('touchstart', handleTouchStart, { passive: true });
  track.addEventListener('touchmove', handleTouchMove, { passive: false });
  track.addEventListener('touchend', handleTouchEnd, { passive: true });
  track.addEventListener('touchcancel', () => { state.isDragging = false; }, { passive: true });
  
  prevBtn?.addEventListener('click', handlePrevClick);
  nextBtn?.addEventListener('click', handleNextClick);
  
  dots.forEach(dot => {
    dot.addEventListener('click', handleDotClick);
  });
  
  // Prevent context menu on long press
  track.addEventListener('contextmenu', (e) => e.preventDefault());
  
  // Initialize
  updateCarousel(false);
}
</script>

<style>
.mobile-swipe-container {
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
}

.mobile-swipe-track {
  display: flex;
  width: 100%;
  will-change: transform;
}

.mobile-swipe-slide {
  flex: 0 0 100%;
  position: relative;
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

.mobile-swipe-slide img {
  pointer-events: none;
  user-select: none;
  -webkit-user-select: none;
}

.mobile-arrow {
  touch-action: manipulation;
}
</style>