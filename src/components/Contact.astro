---
// src/components/Contact.astro - Simple contact with email link
---

<section id="contact" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 epilogue" data-translate="contact-title">
          Kontakt aufnehmen
        </h2>
        <p class="text-xl text-gray-600 epilogue" data-translate="contact-subtitle">
          Bereit für ein Projekt oder eine Auftragsarbeit?
        </p>
        <div class="w-24 h-1 bg-gradient-to-r from-pink-500 to-blue-500 mx-auto mt-4 rounded-full"></div>
      </div>

      <!-- Contact Info -->
      <div class="bg-gray-50 rounded-2xl p-8 md:p-12 text-center space-y-8">
        <!-- Email Box -->
        <div class="space-y-6">
          <div class="flex justify-center">
            <svg class="w-16 h-16 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>

          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-3 epilogue" data-translate="contact-email-heading">Kontaktieren Sie mich</h3>
            <p class="text-gray-600 mb-6" data-translate="contact-email-desc">
              Für Anfragen zu Kunstwerken, Auftragsarbeiten oder allgemeine Fragen schreiben Sie mir gerne eine E-Mail.
            </p>
          </div>

          <!-- Email Button -->
          <a
            href="mailto:info@jxx-design.com?subject=Anfrage über JXX Design Website"
            class="inline-flex items-center justify-center gap-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-semibold py-4 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl epilogue min-h-[56px] text-lg"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <span>info@jxx-design.com</span>
          </a>

          <p class="text-sm text-gray-500 mt-4" data-translate="contact-email-hint">
            Der Klick öffnet Ihr Standard-E-Mail-Programm
          </p>
        </div>

        <!-- Divider -->
        <div class="border-t border-gray-200 my-8"></div>

        <!-- Social Media -->
        <div class="flex justify-center">
          <a href="https://instagram.com/jxx_design" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 text-gray-700 hover:text-purple-600 transition-colors font-medium epilogue">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span data-translate="contact-instagram-label">@jxx_design auf Instagram</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Smooth transitions */
  a {
    transition: all 0.3s ease;
  }
</style>
