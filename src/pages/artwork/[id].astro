---
// src/pages/artwork/[id].astro - Mobile spacing without borders
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { getAllArtworks } from '../../data/series.js';

export function getStaticPaths() {
  const allArtworks = getAllArtworks();
  return allArtworks.map((artwork) => ({
    params: { id: artwork.id },
    props: { artwork },
  }));
}

const { artwork } = Astro.props;
---

<Layout title={`${artwork.title} - JXX Design`}>
  <Navigation />
  
  <!-- Artwork Detail Page -->
  <main class="pt-20 min-h-screen bg-white">
    <!-- Responsive padding for all screen sizes -->
    <div class="px-4 sm:px-6 md:px-8 lg:container py-8 sm:py-12">
      <!-- Back to Gallery -->
      <div class="mb-8">
        <a href="/" class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors duration-300">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span data-translate="back-to-gallery">Back to Gallery</span>
        </a>
      </div>
      
      <!-- Artwork Content -->
      <div class="grid lg:grid-cols-2 gap-6 sm:gap-8 md:gap-12 max-w-6xl mx-auto">
        <!-- Artwork Image with Responsive Spacing -->
        <div class="space-y-4 sm:space-y-6 px-2 sm:px-0">
          <div class="bg-gray-50 rounded-2xl overflow-hidden">
            <img 
              src={artwork.image} 
              alt={artwork.title}
              class="w-full h-auto object-cover"
            />
          </div>
          
          <!-- Artwork ID -->
          <div class="text-center">
            <span class="inline-block bg-gray-100 text-gray-600 px-4 py-2 rounded-full text-sm font-mono epilogue">
              #{artwork.id}
            </span>
          </div>
        </div>
        
        <!-- Artwork Details and Contact with Responsive Spacing -->
        <div class="space-y-6 sm:space-y-8 px-2 sm:px-0">
          <!-- Artwork Info -->
          <div class="space-y-6">
            <div>
              <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">{artwork.title}</h1>
              {artwork.sold ? (
                <div class="inline-block bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-medium" data-translate="sold">
                  Sold
                </div>
              ) : artwork.price && (
                <div class="text-2xl md:text-3xl font-bold text-gray-900">€{artwork.price}</div>
              )}
            </div>
            
            <div class="space-y-3 text-gray-600">
              <div class="flex justify-between">
                <span class="font-medium" data-translate="dimensions">Dimensions:</span>
                <span>{artwork.dimensions}</span>
              </div>
              <div class="flex justify-between">
                <span class="font-medium" data-translate="medium">Medium:</span>
                <span>{artwork.medium}</span>
              </div>
              <div class="flex justify-between">
                <span class="font-medium" data-translate="year">Year:</span>
                <span>{artwork.year}</span>
              </div>
            </div>
            
            {artwork.description && (
              <div class="border-t pt-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-3" data-translate="about-this-piece">About this piece</h3>
                <p class="text-gray-600 leading-relaxed">{artwork.description}</p>
              </div>
            )}
          </div>
          
          <!-- Contact Section -->
          <div class="border-t pt-6 sm:pt-8">
            <div class="bg-gray-50 rounded-2xl p-4 sm:p-6 md:p-8 text-center space-y-6">
              <h2 class="text-xl md:text-2xl font-bold text-gray-900 epilogue">
                {artwork.sold ? 'Interested in Similar Work?' : 'Interested in this Artwork?'}
              </h2>

              <p class="text-gray-600">
                {artwork.sold
                  ? 'Dieses Werk wurde verkauft, aber ich habe ähnliche Arbeiten. Kontaktieren Sie mich für mehr Informationen.'
                  : 'Kontaktieren Sie mich für weitere Informationen zu diesem Kunstwerk, Preis und Verfügbarkeit.'
                }
              </p>

              <!-- Email Button -->
              <a
                href={`mailto:info@jxx-design.com?subject=Anfrage zu Artwork ${artwork.id} - ${artwork.title}&body=Hallo,%0D%0A%0D%0AIch interessiere mich für das Kunstwerk:%0D%0A- ID: ${artwork.id}%0D%0A- Titel: ${artwork.title}%0D%0A- Preis: €${artwork.price}%0D%0A%0D%0ABitte kontaktieren Sie mich für weitere Informationen.%0D%0A%0D%0AMit freundlichen Grüßen`}
                class="inline-flex items-center justify-center gap-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-semibold py-4 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl epilogue min-h-[56px] text-lg"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <span>Per Email anfragen</span>
              </a>

              <p class="text-sm text-gray-500">
                Der Klick öffnet Ihr Email-Programm mit vorausgefüllter Anfrage zu Artwork #{artwork.id}
              </p>

              <!-- Additional Info -->
              <div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-100 text-left">
                <p class="text-sm text-gray-700">
                  <strong>Tipp:</strong> In der Email finden Sie bereits alle wichtigen Informationen zum Kunstwerk. Sie können Ihre Nachricht gerne personalisieren.
                </p>
              </div>
            </div>
          </div>
        </div>
</Layout>
