---
export interface Props {
  series: {
    id: string;
    title: string;
    description: string;
    artworks: Array<{
      id: string;
      title: string;
      price: string;
      sold: boolean;
      image: string;
    }>;
  };
  imageLeft?: boolean;
}

const { series, imageLeft = false } = Astro.props;
---

<div class={`series-container ${imageLeft ? 'image-left' : 'image-right'} w-full max-w-6xl mx-auto`}>
  <!-- Desktop Layout -->
  <div class="hidden md:grid md:grid-cols-2 gap-16 items-center px-4">
    <div class={`carousel-container ${imageLeft ? '' : 'md:order-2'}`}>
      <div class="relative bg-white rounded-xl shadow-sm overflow-hidden mx-auto max-w-md">
        <div class="desktop-carousel relative" data-series={series.id}>
          <div class="desktop-track flex transition-transform duration-500 ease-in-out">
            {series.artworks.map((artwork, index) => (
              <div class="desktop-slide flex-shrink-0 w-full relative group cursor-pointer" data-artwork-id={artwork.id}>
                <a href={`/artwork/${artwork.id}`} class="block w-full h-full">
                  <img 
                    src={artwork.image} 
                    alt={artwork.title}
                    class="w-full h-80 object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/5 to-transparent group-hover:from-black/10 transition-all duration-300"></div>
                </a>
                {artwork.sold && (
                  <div class="absolute top-3 right-3 bg-white text-gray-900 px-2 py-1 rounded-md text-xs font-medium shadow-sm">
                    Sold
                  </div>
                )}
              </div>
            ))}
          </div>
          
          {series.artworks.length > 1 && (
            <>
              <button class="desktop-prev absolute left-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-600 rounded-full p-2 shadow-md z-10">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
              </button>
              <button class="desktop-next absolute right-3 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white text-gray-600 rounded-full p-2 shadow-md z-10">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </>
          )}
        </div>
        
        {series.artworks.length > 1 && (
          <div class="flex justify-center space-x-1.5 py-3 bg-white">
            {series.artworks.map((_, index) => (
              <button 
                class={`desktop-dot w-1.5 h-1.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-gray-700' : 'bg-gray-300'}`}
                data-index={index}
              ></button>
            ))}
          </div>
        )}
      </div>
    </div>
    
    <div class={`content-container ${imageLeft ? 'md:order-2' : 'md:order-1'} flex flex-col justify-center`}>
      <div class={`space-y-4 ${!imageLeft ? 'text-right' : 'text-left'} max-w-md mx-auto`}>
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 epilogue">{series.title}</h3>
        </div>
        
        <div class="desktop-artwork-info">
          {series.artworks.map((artwork, index) => (
            <div class={`desktop-info ${index === 0 ? 'block' : 'hidden'}`} data-info-index={index}>
              <div class="space-y-1">
                <div class="text-xl font-bold text-gray-900 epilogue">#{artwork.id}</div>
                <div class="text-base font-medium text-gray-700 epilogue">{artwork.title}</div>
                {!artwork.sold && (
                  <div class="text-base font-medium text-gray-900 epilogue">€{artwork.price}</div>
                )}
                {artwork.sold && (
                  <div class="text-base font-medium text-gray-900 epilogue">Sold</div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  
  <!-- Mobile Layout with MORE SPACE and WORKING SWIPE -->
  <div class="md:hidden px-8">
    <div class="space-y-8 max-w-sm mx-auto">
      <div class="text-center">
        <h3 class="text-xl font-bold text-gray-900 mb-6 epilogue">{series.title}</h3>
      </div>
      
      <!-- Mobile Carousel with Extra Spacing -->
      <div class="px-4">
        <div class="relative bg-white rounded-xl shadow-sm overflow-hidden" id={`mobile-carousel-${series.id}`}>
          <div class="swiper-container">
            <div class="swiper-track flex" style="transform: translateX(0%); transition: none;">
              {series.artworks.map((artwork, index) => (
                <div class="swiper-slide w-full flex-shrink-0" data-index={index}>
                  <img 
                    src={artwork.image} 
                    alt={artwork.title}
                    class="w-full h-72 object-cover select-none"
                    draggable="false"
                  />
                  {artwork.sold && (
                    <div class="absolute top-3 right-3 bg-white text-gray-900 px-2 py-1 rounded-md text-xs font-medium shadow-sm">
                      Sold
                    </div>
                  )}
                </div>
              ))}
            </div>
            
            {series.artworks.length > 1 && (
              <>
                <button class="swiper-prev absolute left-2 top-1/2 -translate-y-1/2 bg-white/90 text-gray-600 rounded-full p-2 shadow-md z-20">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </button>
                <button class="swiper-next absolute right-2 top-1/2 -translate-y-1/2 bg-white/90 text-gray-600 rounded-full p-2 shadow-md z-20">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </button>
              </>
            )}
          </div>
          
          {series.artworks.length > 1 && (
            <div class="flex justify-center space-x-1.5 py-3 bg-white">
              {series.artworks.map((_, index) => (
                <button 
                  class={`swiper-dot w-1.5 h-1.5 rounded-full transition-colors duration-200 ${index === 0 ? 'bg-gray-700' : 'bg-gray-300'}`}
                  data-index={index}
                ></button>
              ))}
            </div>
          )}
        </div>
      </div>
      
      <!-- Mobile Artwork Info - CLICKABLE TEXT -->
      <div class="text-center px-4">
        <div class="bg-gray-50 rounded-xl p-6">
          {series.artworks.map((artwork, index) => (
            <div class={`mobile-info ${index === 0 ? 'block' : 'hidden'}`} data-info-index={index}>
              <a href={`/artwork/${artwork.id}`} class="block p-3 hover:bg-gray-100 rounded-lg transition-colors duration-200">
                <div class="space-y-2">
                  <div class="text-lg font-bold text-gray-900">#{artwork.id}</div>
                  <div class="text-sm font-medium text-gray-700">{artwork.title}</div>
                  {!artwork.sold && (
                    <div class="text-sm font-medium text-gray-900">€{artwork.price}</div>
                  )}
                  {artwork.sold && (
                    <div class="text-sm font-medium text-gray-900">Sold</div>
                  )}
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Desktop carousels
  document.querySelectorAll('.desktop-carousel').forEach(initDesktop);
  
  // Mobile carousels - NEW IMPLEMENTATION
  document.querySelectorAll('[id^="mobile-carousel-"]').forEach(initMobile);
});

function initDesktop(carousel) {
  const track = carousel.querySelector('.desktop-track');
  const slides = carousel.querySelectorAll('.desktop-slide');
  const dots = carousel.parentElement.querySelectorAll('.desktop-dot');
  const prevBtn = carousel.querySelector('.desktop-prev');
  const nextBtn = carousel.querySelector('.desktop-next');
  
  let currentIndex = 0;
  
  function update() {
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
    
    dots.forEach((dot, i) => {
      dot.classList.toggle('bg-gray-700', i === currentIndex);
      dot.classList.toggle('bg-gray-300', i !== currentIndex);
    });
    
    const container = carousel.closest('.series-container');
    const infos = container.querySelectorAll('.desktop-info');
    infos.forEach((info, i) => {
      info.classList.toggle('block', i === currentIndex);
      info.classList.toggle('hidden', i !== currentIndex);
    });
  }
  
  function goTo(index) {
    currentIndex = index >= slides.length ? 0 : index < 0 ? slides.length - 1 : index;
    update();
  }
  
  prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));
  nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
}

function initMobile(container) {
  const swiperContainer = container.querySelector('.swiper-container');
  const track = container.querySelector('.swiper-track');
  const slides = container.querySelectorAll('.swiper-slide');
  const dots = container.querySelectorAll('.swiper-dot');
  const prevBtn = container.querySelector('.swiper-prev');
  const nextBtn = container.querySelector('.swiper-next');
  
  if (slides.length <= 1) return;
  
  let current = 0;
  let startX = 0;
  let moving = false;
  let startTime = 0;
  
  function updateMobile() {
    track.style.transition = 'transform 300ms ease';
    track.style.transform = `translateX(-${current * 100}%)`;
    
    // Update dots
    dots.forEach((dot, i) => {
      dot.classList.toggle('bg-gray-700', i === current);
      dot.classList.toggle('bg-gray-300', i !== current);
    });
    
    // Update info
    const section = container.closest('.md\\:hidden');
    const infos = section.querySelectorAll('.mobile-info');
    infos.forEach((info, i) => {
      info.classList.toggle('block', i === current);
      info.classList.toggle('hidden', i !== current);
    });
  }
  
  function goToSlide(index) {
    current = index >= slides.length ? 0 : index < 0 ? slides.length - 1 : index;
    updateMobile();
  }
  
  // Touch events
  swiperContainer.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
    startTime = Date.now();
    moving = false;
    track.style.transition = 'none';
  });
  
  swiperContainer.addEventListener('touchmove', (e) => {
    const currentX = e.touches[0].clientX;
    const diff = currentX - startX;
    
    if (Math.abs(diff) > 10) {
      moving = true;
      e.preventDefault();
      
      const percent = (diff / track.offsetWidth) * 100;
      const translate = (-current * 100) + percent;
      track.style.transform = `translateX(${translate}%)`;
    }
  });
  
  swiperContainer.addEventListener('touchend', (e) => {
    if (!moving) return;
    
    const endX = e.changedTouches[0].clientX;
    const diff = endX - startX;
    const time = Date.now() - startTime;
    const velocity = Math.abs(diff) / time;
    
    if (Math.abs(diff) > 50 || velocity > 0.3) {
      if (diff > 0) {
        goToSlide(current - 1);
      } else {
        goToSlide(current + 1);
      }
    } else {
      updateMobile();
    }
    
    moving = false;
  });
  
  // Buttons
  prevBtn?.addEventListener('click', () => goToSlide(current - 1));
  nextBtn?.addEventListener('click', () => goToSlide(current + 1));
  
  // Dots
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => goToSlide(i));
  });
  
  // Initialize
  updateMobile();
}
</script>

<style>
.swiper-container {
  position: relative;
  overflow: hidden;
  touch-action: pan-y;
}

.swiper-track {
  will-change: transform;
}

.swiper-slide {
  position: relative;
  user-select: none;
  -webkit-user-select: none;
}

.swiper-slide img {
  pointer-events: none;
}
</style>